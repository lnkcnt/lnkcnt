generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model links {
  id           String @id @db.VarChar(32)
  redirect_url String @db.VarChar(128)
}

model urlManagePage {
  id         String @id @db.VarChar(32)
  managePage String @unique(map: "managePage") @db.VarChar(32)
}

model linkClickCount {
  clickId Int      @id @default(autoincrement())
  id      String   @db.VarChar(32)
  ip      String   @db.VarChar(38)
  date    DateTime @db.DateTime(0)

  @@index([id], map: "idx_id")
}
