generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model linkclickcount {
  clickid Int      @id(map: "linkclickcount_pk") @default(autoincrement())
  id      String   @unique(map: "linkclickcount_unique") @db.VarChar(32)
  ip      String   @db.VarChar(38)
  date    DateTime @db.Timestamp(6)
}

model links {
  id           String @id(map: "links_pk") @db.VarChar(32)
  redirect_url String @db.VarChar(128)
}

model tester {
  flag Boolean @default(true)
  id   String  @id(map: "tester_pk") @default(dbgenerated("SUBSTRING(md5((random())::text) FROM 1 FOR 8)")) @db.VarChar(8)
}

model urlblacklist {
  blacklistid Int      @id(map: "urlblacklist_pk") @default(autoincrement())
  pattern     String   @unique(map: "urlblacklist_unique") @db.VarChar(255)
  note        String?  @db.VarChar(255)
  createdat   DateTime @default(now()) @db.Timestamp(6)
}

model urlmanagepage {
  id         String @id(map: "urlmanagepage_pk") @db.VarChar(32)
  managepage String @unique(map: "urlmanagepage_unique") @db.VarChar(32)
}

model urlreport {
  reportid  Int      @id(map: "urlreport_pk") @default(autoincrement())
  id        String   @unique(map: "urlreport_unique") @db.VarChar(32)
  reason    String   @db.VarChar(50)
  message   String
  ip        String   @db.VarChar(38)
  createdat DateTime @default(now()) @db.Timestamp(6)
}
