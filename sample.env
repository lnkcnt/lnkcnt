# Rename this file to .env

# PostgreSQL root password. it is strongly recommended to use randomly generated password.
POSTGRES_PASSWORD=rootPassword
# PostgreSQL username (not root)
DATABASE_USER=userName
# PostgreSQL user password (not root)
DATABASE_PASSWORD=userPassword

DATABASE_HOST=postgres # For container(production). comment it to use localhost.
DATABASE_PORT=5432
DATABASE_NAME=lnkcnt