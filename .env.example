# Rename this file to .env

# Used when database server initiation.
MARIADB_ROOT_PASSWORD="rootPassword"
DATABASE_USER="userName"
DATABASE_PASSWORD="userPassword"
# DATABASE_HOST="mariadb" # For container(production). comment it to use localhost.
DATABASE_NAME="lnkcnt"

DATABASE_URL=mysql://user:password@localhost:3306/lnkcnt

# Better auth authentication config.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # use "pnpx auth@latest secret" to generate secret

# Password used for admin account creation.
ADMIN_CREATION_SECRET=